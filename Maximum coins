r=[]
t=int(input())
for i in range(t):
    n,x=map(int,input().split())
    cv=[2**i for i in range(1,n+1)]
    cv.sort(reverse=True)
    cw=sum(cv[:x])
    cl=sum(cv[x:])
    mc=cw-cl
    print(mc)
